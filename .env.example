# LLM (engine interpretation). Leave empty to use the offline keyword fallback.
ANTHROPIC_API_KEY=
ENGINE_MODEL=
CONFIDENCE_MIN=0.7
INGEST_MODEL=                # PDF drafting at plan time (empty = claude-opus-5-5)

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_SITE_GROUP_ID=

# WhatsApp Business Cloud API (stretch)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Email (stretch / via n8n)
SMTP_URL=
IMAP_URL=

# Runtime
PLAN_PATH=data/demo/plan.json
DB_PATH=data/kraftsync.db
TZ=Europe/Vienna
DEMO_TODAY=2026-11-09        # freeze "today" for the demo story; empty = real date
DRY_RUN=1                    # 1 = log actions, don't send
DEMO_REDIRECT_CHAT_ID=       # send every outbound message to this chat (stage mode)
