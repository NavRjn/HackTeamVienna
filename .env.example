# LLM (engine interpretation). Leave empty to use the offline keyword fallback.
ANTHROPIC_API_KEY=
ENGINE_MODEL=
CONFIDENCE_MIN=0.7

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_SITE_GROUP_ID=

# WhatsApp Business Cloud API (stretch)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Email (stretch / via n8n)
SMTP_URL=
IMAP_URL=

# Runtime
PLAN_PATH=data/demo/plan.json
DB_PATH=data/kraftsync.db
TZ=Europe/Vienna
DEMO_TODAY=2026-11-09        # freeze "today" for the demo story; empty = real date
DRY_RUN=1                    # 1 = log actions, don't send
DEMO_REDIRECT_CHAT_ID=       # send every outbound message to this chat (stage mode)

# Local service (kraftsync.app.serve). Token + port are generated into .env on first run.
KRAFTSYNC_TOKEN=
KRAFTSYNC_HOST=0.0.0.0        # LAN-reachable; use 127.0.0.1 to keep it local
KRAFTSYNC_PORT=               # empty = random free port, saved on first run
KRAFTSYNC_DOCS=0              # 1 = Swagger UI (loopback only)
N8N_CONFLICT_WEBHOOK_URL=     # n8n webhook called when there is a conflict
N8N_HOOK_TOKEN=               # sent to n8n as X-KraftSync-Token
EVENTS_PATH=data/events.jsonl
