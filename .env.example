# ---- Local service (read by kraftsync.app.serve) --------------------------------------
# Token + port are generated into .env on first run (`uv run python -m kraftsync.app.serve`).
KRAFTSYNC_TOKEN=
KRAFTSYNC_HOST=0.0.0.0        # LAN-reachable; use 127.0.0.1 to keep it local
KRAFTSYNC_PORT=               # empty = random free port, saved on first run
KRAFTSYNC_DOCS=0              # 1 = Swagger UI (loopback only)
PLAN_PATH=data/demo/plan.json
EVENTS_PATH=data/events.jsonl
LOG_PATH=data/kraftsync.log     # compact one-line-per-call log (console always); `off` = console only
CONFIDENCE_MIN=0.7            # below this the sender is asked instead of the claim being applied
DEMO_TODAY=2026-11-09         # freeze "today" for the demo story; empty = message date / real date
DEMO_REDIRECT_CHAT_ID=        # stage mode: send every outbound message to this Telegram chat
N8N_CONFLICT_WEBHOOK_URL=     # optional: n8n webhook called when there is a conflict
N8N_HOOK_TOKEN=               # sent to that webhook as X-KraftSync-Token

# ---- Not read by the local service --------------------------------------------------------
# The LLM and Telegram credentials live in n8n (Credentials), not here. Kept for reference only.
# ANTHROPIC_API_KEY=
# TELEGRAM_BOT_TOKEN=
